{
  "name": "meishi-jiandaobu-web",
  "private": true,
  "version": "0.1.0",
  "description": "美食剪刀布网页版：今天想吃什么？专挑附近 Google 评价最好的 3 家。",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-no-keys.ts dist && node scripts/check-size.ts dist",
    "preview": "vite preview",
    "serve:subpath": "node scripts/serve-subpath.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test --grep-invert @shots",
    "shots": "npm run build && playwright test --grep @shots",
    "check:keys": "node scripts/check-no-keys.ts dist",
    "check:size": "node scripts/check-size.ts dist",
    "icons": "node scripts/make-icons.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
